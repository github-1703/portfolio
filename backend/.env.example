# Copy to .env for local development. Never commit the real .env.
# On Render, set these in the dashboard under Environment instead.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres URL (Render provides this)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Local development email (Gmail SMTP) ---
# Gmail requires a 16-character App Password (Google Account -> Security ->
# App passwords), not your normal password.
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# Where contact-form notifications are delivered.
CONTACT_EMAIL=you@gmail.com

# --- Production email over HTTPS (required on Render free tier) ---
# Render blocks SMTP ports, so set BREVO_API_KEY to send via Brevo instead.
# Sign up free at https://brevo.com, verify the sender address, then create an
# API key under Settings -> SMTP & API -> API Keys.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=you@gmail.com
BREVO_SENDER_NAME=Portfolio Contact Form

# --- Cloudinary media storage ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
